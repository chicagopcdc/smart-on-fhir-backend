# Copy this file to .env and fill in the values. The real .env is gitignored.

# OAuth client_id for the production Epic (UChicago) provider.
# Not needed for the Epic sandbox, which uses its own credentials.
EPIC_CLIENT_ID=

# Async SQLAlchemy connection string for the Postgres store (asyncpg driver).
# Matches the local Docker Postgres in the README.
DATABASE_URL=postgresql+asyncpg://postgres:devpass@localhost:5432/smartfhir

# Fernet key used to encrypt tokens at rest. Required — the app will not start
# without it. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# How long (seconds) an OAuth state row stays valid before the TTL sweep removes it.
OAUTH_STATE_TTL_SECONDS=600
