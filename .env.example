# Copy this file to .env and fill in the values. The real .env is gitignored.

# OAuth client credentials for the Epic sandbox (public test server at
# fhir.epic.com). Register an app at https://fhir.epic.com to obtain these;
# the redirect_uri registered there must match FRONTEND_HOSTNAME below.
EPIC_SANDBOX_CLIENT_ID=
EPIC_SANDBOX_CLIENT_SECRET=

# OAuth client credentials for the production Epic (UChicago) provider.
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=

# FHIR base URL (issuer) of the production Epic deployment. Authorization is
# only allowed against this issuer for the EPIC provider; leave it unset and
# the EPIC provider rejects every request.
EPIC_ISSUER=

# Client id for the Cerner / Oracle Health sandbox, registered as a public client
# in Oracle Health's code Console (PKCE replaces the secret). Leave unset and the
# CERNER_SANDBOX provider rejects every request.
CERNER_CLIENT_ID=

# Client id for the public SMART App Launcher (launch.smarthealthit.org). The
# launcher does not validate it, so this is optional — a default is used when
# unset. Override only to mirror a specific registration.
SMART_LAUNCHER_CLIENT_ID=

# Base URL of the frontend that handles the OAuth redirect. Each provider's
# redirect_uri is FRONTEND_HOSTNAME + "/auth/callback".
FRONTEND_HOSTNAME=http://localhost:3000

# REQUIRED. Async SQLAlchemy connection string for the Postgres store (asyncpg
# driver). The app refuses to start without it. Local dev example:
#   DATABASE_URL=postgresql+asyncpg://postgres:devpass@localhost:5432/smartfhir
DATABASE_URL=

# REQUIRED. One or more Fernet keys, comma-separated, used to encrypt tokens at
# rest. The FIRST key encrypts; the rest are still accepted for decryption, so
# rotate by prepending a new key (e.g. "newkey,oldkey") — stored tokens stay
# readable. Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# How long (seconds) an OAuth state row stays valid before the TTL sweep removes it.
OAUTH_STATE_TTL_SECONDS=600

# How long (seconds) an app session — the bearer the frontend uses to read
# resources after authorizing — stays valid before the caller must re-authorize.
APP_SESSION_TTL_SECONDS=3600

# How close (seconds) to its expiry a stored access token may be before a read
# refreshes it first, rather than sending one that may lapse partway through the
# fan-out of FHIR calls. Note: refreshes are coalesced per connection in-process,
# so two workers can still each spend the same refresh token at the same instant;
# a multi-worker deployment wants a shared lock. Same caveat as the rate limits
# below.
TOKEN_REFRESH_LEEWAY_SECONDS=60

# Browser origins allowed to call the API (CORS), comma-separated. Defaults to
# FRONTEND_HOSTNAME when unset. Set this in any deployment where the frontend is
# served from a different origin, e.g. https://app.example.org.
CORS_ALLOWED_ORIGINS=

# Per-client rate limits (slowapi "<count>/<window>" syntax). Set
# RATE_LIMIT_ENABLED=false to turn throttling off for local single-user runs.
# Note: limits are counted in-process, so a multi-worker deployment needs a
# shared storage backend to enforce them globally; and the client key is the
# socket peer, so behind a reverse proxy add trusted X-Forwarded-For handling
# or every user shares one bucket.
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT=10/minute
FHIR_RATE_LIMIT=30/minute
