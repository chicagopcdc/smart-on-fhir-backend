# Copy this file to .env and fill in the values. The real .env is gitignored.

# OAuth client credentials for the Epic sandbox (public test server at
# fhir.epic.com). Register an app at https://fhir.epic.com to obtain these;
# the redirect_uri registered there must match FRONTEND_HOSTNAME below.
EPIC_SANDBOX_CLIENT_ID=
EPIC_SANDBOX_CLIENT_SECRET=

# OAuth client credentials for the production Epic (UChicago) provider.
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=

# FHIR base URL (issuer) of the production Epic deployment. Authorization is
# only allowed against this issuer for the EPIC provider; leave it unset and
# the EPIC provider rejects every request.
EPIC_ISSUER=

# Credentials for the Cerner / Oracle Health sandbox application, registered in
# Oracle Health's code Console as patient-facing and confidential. The secret is
# issued through a Cerner Central system account, linked from the application's
# details page in code Console. Leave either unset and the CERNER_SANDBOX provider
# rejects every request, and GET /providers omits it.
CERNER_CLIENT_ID=
CERNER_CLIENT_SECRET=

# Client id for the public SMART App Launcher (launch.smarthealthit.org). The
# launcher does not validate it, so this is optional — a default is used when
# unset. Override only to mirror a specific registration.
SMART_LAUNCHER_CLIENT_ID=

# Base URL of the frontend that handles the OAuth redirect. Each provider's
# redirect_uri is FRONTEND_HOSTNAME + "/auth/callback", and the identity
# provider's is FRONTEND_HOSTNAME + "/auth/login/callback".
FRONTEND_HOSTNAME=http://localhost:3000

# --- signing users in ---------------------------------------------------------
# Who someone is, as opposed to which records they connected. Optional: leave
# OIDC_ISSUER unset and the login routes answer 503, `GET /auth/providers`
# reports loginEnabled false, and connecting works anonymously exactly as before.
#
# Any OIDC provider works, because everything but these three values is read
# from the issuer's .well-known/openid-configuration at runtime:
#
#   Okta      OIDC_ISSUER=https://<your-org>.okta.com/oauth2/default
#             Create an OIDC "Web Application" (or SPA, if you want a public
#             client and no secret) in the Okta admin console. Its "Sign-in
#             redirect URI" must be FRONTEND_HOSTNAME + "/auth/login/callback",
#             and its "Sign-out redirect URI" FRONTEND_HOSTNAME, or Okta refuses
#             the redirect back.
#
#   Keycloak  OIDC_ISSUER=https://<host>/realms/<realm>
#             The issuer is a *realm*, not the server: one Keycloak serves many,
#             and the realm is what holds the users and the client. Register an
#             OpenID Connect client in that realm with:
#               Valid redirect URIs      FRONTEND_HOSTNAME + /auth/login/callback
#               Valid post logout URIs   FRONTEND_HOSTNAME
#               Web origins              FRONTEND_HOSTNAME
#             The post-logout entry is the one that is easy to miss: Keycloak
#             defaults it to the sign-in redirect URIs, which FRONTEND_HOSTNAME
#             is not one of, and answers "Invalid redirect uri" on sign-out
#             until it is added. Client authentication On gives you a
#             confidential client and a secret under Credentials; leave it Off
#             for a public one. Either way PKCE is sent, so setting the client's
#             "Proof Key for Code Exchange Code Challenge Method" to S256 is
#             safe and worth doing.
#
#             `docker compose --profile keycloak up` runs one locally with all
#             of the above already registered — see "Running Keycloak locally"
#             in the README.
#
#   Google    OIDC_ISSUER=https://accounts.google.com
#             Credentials come from a Google Cloud project's OAuth client; the
#             same redirect URI goes in "Authorized redirect URIs".
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Omit for a public client, which authenticates with PKCE alone. PKCE is sent
# either way.
OIDC_CLIENT_SECRET=

# Scopes requested at sign-in. "openid" is what makes it an OIDC request at all;
# the other two populate the account's email and name. None of this grants access
# to health data — that is the SMART flow's business, and a separate consent.
OIDC_SCOPES=openid profile email

# How long (seconds) a sign-in that has been started stays valid before the user
# has to begin again. Separate from OAUTH_STATE_TTL_SECONDS because the two bound
# different journeys, and an IdP login may involve MFA.
LOGIN_STATE_TTL_SECONDS=600

# How much clock skew (seconds) to tolerate on an ID token's exp/iat. A few
# seconds of drift between the IdP's clock and this server's is ordinary; with no
# leeway it reads as a token from the future.
OIDC_CLOCK_SKEW_SECONDS=60

# Whether POST /auth/connect requires being signed in. False by default, so
# adding login does not break a frontend that has not adopted it yet. Turn it on
# once the frontend signs users in: it closes the anonymous path, and with it the
# case where a patient record is created that nobody can ever get back to.
REQUIRE_USER_LOGIN=false

# REQUIRED. Async SQLAlchemy connection string for the Postgres store (asyncpg
# driver). The app refuses to start without it. Local dev example:
#   DATABASE_URL=postgresql+asyncpg://postgres:devpass@localhost:5432/smartfhir
# Under docker compose this is set for you and points at the db service, so a
# value here is ignored by the containers and used only by a Poetry run.
DATABASE_URL=

# REQUIRED. One or more Fernet keys, comma-separated, used to encrypt tokens at
# rest. The FIRST key encrypts; the rest are still accepted for decryption, so
# rotate by prepending a new key (e.g. "newkey,oldkey") — stored tokens stay
# readable. Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# docker compose supplies a development key of its own, so this is for a Poetry
# run, or to override the one the compose stack would otherwise use.
TOKEN_ENCRYPTION_KEY=

# How long (seconds) an OAuth state row stays valid before the TTL sweep removes it.
OAUTH_STATE_TTL_SECONDS=600

# How long (seconds) an app session — the bearer the frontend uses to read
# resources after authorizing — stays valid before the caller must re-authorize.
APP_SESSION_TTL_SECONDS=3600

# How close (seconds) to its expiry a stored access token may be before a read
# refreshes it first, rather than sending one that may lapse partway through the
# fan-out of FHIR calls. Note: refreshes are coalesced per connection in-process,
# so two workers can still each spend the same refresh token at the same instant;
# a multi-worker deployment wants a shared lock. Same caveat as the rate limits
# below.
TOKEN_REFRESH_LEEWAY_SECONDS=60

# How long (days) a connection that can still be refreshed is kept after the
# last time anything read it. Reading a patient's record resets this for every
# connection on it, so the window only ever runs out on one nobody is using.
# A connection that cannot be refreshed at all — no refresh token, or one the
# provider has refused — is worth no more than its access token and is not made
# to wait this out. Nothing is ever removed while a live session can reach its
# record, or while its own access token still works, so 0 is a usable setting
# and means "keep nothing nobody is using" rather than "keep nothing".
CONNECTION_RETENTION_DAYS=30

# Browser origins allowed to call the API (CORS), comma-separated. Defaults to
# FRONTEND_HOSTNAME when unset. Set this in any deployment where the frontend is
# served from a different origin, e.g. https://app.example.org.
CORS_ALLOWED_ORIGINS=

# Per-client rate limits (slowapi "<count>/<window>" syntax). Set
# RATE_LIMIT_ENABLED=false to turn throttling off for local single-user runs.
# Note: limits are counted in-process, so a multi-worker deployment needs a
# shared storage backend to enforce them globally; and the client key is the
# socket peer, so behind a reverse proxy every user shares one bucket until
# uvicorn is told which peer's X-Forwarded-For to trust. That is FORWARDED_ALLOW_IPS,
# read by uvicorn rather than by this application, so it belongs in the container's
# environment rather than here. See "Deploying it" in the README.
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT=10/minute
FHIR_RATE_LIMIT=30/minute
# The endpoint check spends an outbound request on a host the caller names, so it
# gets its own budget: letting a user try a few endpoints must not also loosen the
# throttle in front of the token endpoints.
ENDPOINT_CHECK_RATE_LIMIT=20/minute

# How a log line is written: "text" for the one a developer reads, "json" for one
# object per line where something downstream parses them. What may appear in a
# line is not this setting's business — no token, session, provider-issued patient
# id or resource content is written under either. See "Logs" in the README.
LOG_FORMAT=text

# --- docker compose only ------------------------------------------------------
# Read by docker-compose.yml, not by the application. Every one has a default,
# so the stack comes up without setting any of them; uncomment to override.
#
# Port the API is published on. http://localhost:<APP_PORT>/docs.
# APP_PORT=8000
#
# Port Postgres is published on. Not 5432 by default, because a Postgres on the
# host's 5432 is common enough to assume. Nothing in the stack uses this; it is
# there so you can point psql at the container.
# POSTGRES_PORT=5433
#
# Port the local Keycloak is published on, under the "keycloak" profile. It has
# to match the port in OIDC_ISSUER, because the issuer is one string that both
# the browser and this backend resolve — see the README.
# KEYCLOAK_PORT=8080
#
# The admin account the local Keycloak is bootstrapped with, at
# http://localhost:<KEYCLOAK_PORT>/admin. Development only; the realm it serves
# is a fixture.
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=admin
#
# Credentials the database is created with, and that DATABASE_URL is built from.
# Keep them to letters, digits, hyphens and underscores: the DSN is assembled by
# string interpolation, so an "@" in a password splits the host off it and a "%"
# fails the migration.
# Postgres reads them only while its data directory is still empty, so changing
# one after a first run moves the DSN and leaves the database where it was, and
# the migration fails to authenticate. Change them on a fresh volume
# (docker compose down -v) or not at all.
# POSTGRES_USER=smartfhir
# POSTGRES_PASSWORD=smartfhir
# POSTGRES_DB=smartfhir
