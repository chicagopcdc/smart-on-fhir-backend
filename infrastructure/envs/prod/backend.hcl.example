# Copy to backend.hcl and fill in, then:
#
#   terraform init -backend-config=backend.hcl
#
# Not committed, because it names a specific account's bucket and because the
# state it points at holds the database password and the token encryption key in
# cleartext. The bucket wants, at minimum:
#
#   - default encryption on
#   - versioning on, so a corrupted state can be rolled back
#   - public access blocked
#   - a bucket policy denying anyone outside the deploy role and the humans who
#     operate this environment
#
# use_lockfile replaces the DynamoDB table the S3 backend used to need for state
# locking; it is supported from Terraform 1.10 and this stack requires 1.9, so
# on 1.9 use dynamodb_table instead.

bucket = "REPLACE-terraform-state-bucket"
key    = "smart-on-fhir/prod/terraform.tfstate"
region = "us-east-1"

encrypt = true

# dynamodb_table = "REPLACE-terraform-locks"
# use_lockfile   = true
